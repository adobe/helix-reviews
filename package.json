{
  "name": "@adobe/helix-reviews",
  "version": "1.1.2",
  "description": "Cloudflare Worker for AEM Review System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-skip-pattern=Post-Deploy",
    "test-postdeploy": "TEST_INTEGRATION=true node --test --test-reporter=spec --test-name-pattern=Post-Deploy",
    "lint": "eslint .",
    "semantic-release": "semantic-release",
    "deploy": "wrangler deploy",
    "deploy-ci": "wrangler deploy --config wrangler-ci.toml",
    "dev": "wrangler dev",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/helix-reviews"
  },
  "author": "Adobe",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/helix-reviews/issues"
  },
  "homepage": "https://github.com/adobe/helix-reviews#readme",
  "devDependencies": {
    "@adobe/eslint-config-helix": "3.0.30",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "mocha": "11.8.0",
    "semantic-release": "25.0.9",
    "semantic-release-slack-bot": "4.0.2",
    "wrangler": "4.126.0"
  },
  "dependencies": {
    "cookie": "2.0.1"
  },
  "lint-staged": {
    "*.js": "eslint"
  }
}
